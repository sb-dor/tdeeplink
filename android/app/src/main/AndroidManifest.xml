<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="tdeeplink"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <!-- ===================== DEEP LINKS ===================== -->
            <!-- Turn off Flutter's built-in deep link handling: the app_links plugin handles links instead. -->
            <!-- Without this, Flutter would also try to push the link path as a route and you'd get double navigation. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />

            <!-- 1) CUSTOM SCHEME: tdeeplink://anything -->
            <!-- Works fully offline; no server or domain needed. -->
            <intent-filter>
                <!-- VIEW = "open this data" - the action Android sends when a link is tapped. -->
                <action android:name="android.intent.action.VIEW" />
                <!-- DEFAULT = allows this activity to receive implicit intents (links). -->
                <category android:name="android.intent.category.DEFAULT" />
                <!-- BROWSABLE = allows links tapped in a browser / other apps to reach us. -->
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Match any link whose scheme is "tdeeplink" (any host, any path). Must match kCustomScheme in lib/deep_link_parser.dart. -->
                <data android:scheme="tdeeplink" />
            </intent-filter>

            <!-- 2) APP LINKS: https://example.com/... -->
            <!-- autoVerify = Android downloads https://example.com/.well-known/assetlinks.json at install time. -->
            <!-- If that file lists this app + its signing key, links open the app directly with no "Open with" chooser. -->
            <intent-filter android:autoVerify="true">
                <!-- Same VIEW action as above. -->
                <action android:name="android.intent.action.VIEW" />
                <!-- Same DEFAULT category as above. -->
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Same BROWSABLE category as above. -->
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Only https links (App Links must be https). -->
                <data android:scheme="https" />
                <!-- TODO: replace example.com with your domain (and kWebHost in lib/deep_link_parser.dart). -->
                <data android:host="example.com" />
                <!-- Only open the app for these paths; other pages on the site stay in the browser. -->
                <data android:pathPrefix="/product" />
                <!-- Second allowed path prefix. -->
                <data android:pathPrefix="/profile" />
            </intent-filter>
            <!-- =================== END DEEP LINKS =================== -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
